{
  "name": "@identvia/js",
  "version": "0.1.0",
  "description": "Sign in with Identvia for JavaScript and TypeScript: browser SPA client (PKCE, redirect + popup, refresh-token rotation) and Node server helpers (Express, Next.js, ID token verification).",
  "license": "MIT",
  "author": "Identvia <hello@identvia.com>",
  "homepage": "https://id.identvia.com/developers/docs/js",
  "repository": { "type": "git", "url": "git+https://github.com/identvia/identvia-js.git", "directory": "packages/js" },
  "bugs": "https://github.com/identvia/identvia-js/issues",
  "keywords": ["identvia", "oidc", "openid-connect", "oauth2", "pkce", "sso", "authentication", "agents", "ciba", "token-exchange"],
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=18.17" },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } },
    "./server": { "import": { "types": "./dist/server.d.ts", "default": "./dist/server.js" }, "require": { "types": "./dist/server.d.cts", "default": "./dist/server.cjs" } },
    "./express": { "import": { "types": "./dist/express.d.ts", "default": "./dist/express.js" }, "require": { "types": "./dist/express.d.cts", "default": "./dist/express.cjs" } },
    "./next": { "import": { "types": "./dist/next.d.ts", "default": "./dist/next.js" }, "require": { "types": "./dist/next.d.cts", "default": "./dist/next.cjs" } },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "express": "^4.21.2",
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
