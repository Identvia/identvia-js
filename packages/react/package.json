{
  "name": "@identvia/react",
  "version": "0.1.3",
  "description": "React hooks and components for Sign in with Identvia: IdentviaProvider, useIdentvia, <SignInWithIdentvia/>, <SignedIn/>, <SignedOut/>.",
  "license": "MIT",
  "author": "Identvia <hello@identvia.com>",
  "homepage": "https://identvia.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Identvia/identvia-js.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Identvia/identvia-js/issues",
    "email": "hello@identvia.com"
  },
  "keywords": [
    "identvia",
    "react",
    "oidc",
    "pkce",
    "sign-in",
    "sso"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17",
    "@identvia/js": "^0.1.0"
  },
  "devDependencies": {
    "@identvia/js": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "happy-dom": "^15.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "jose": "^5.9.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
